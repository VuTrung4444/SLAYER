local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local plr = Players.LocalPlayer
local Character = plr.Character or plr.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")

local WalkSpeed = 150
local JumpPower = 200
local isEnabled = false

local BurstOnTime = 0.5
local BurstOffTime = 0.8

local walkSpeedConnection
local jumpPowerConnection
local isBurstOn = false

local function applyStats()
    if not Humanoid then return end
    Humanoid.JumpPower = JumpPower

    if jumpPowerConnection then jumpPowerConnection:Disconnect() end
    jumpPowerConnection = Humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
        if isEnabled and Humanoid.JumpPower ~= JumpPower then
            Humanoid.JumpPower = JumpPower
        end
    end)
end

local function applyBurst()
    if not Humanoid then return end
    Humanoid.WalkSpeed = WalkSpeed

    if walkSpeedConnection then walkSpeedConnection:Disconnect() end
    walkSpeedConnection = Humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if isBurstOn and Humanoid.WalkSpeed ~= WalkSpeed then
            Humanoid.WalkSpeed = WalkSpeed
        end
    end)
end

local function removeBurst()
    if walkSpeedConnection then walkSpeedConnection:Disconnect() end
end

local function removeStats()
    if jumpPowerConnection then jumpPowerConnection:Disconnect() end
    removeBurst()
end

local function setEnabled(value)
    isEnabled = value
    if isEnabled then
        applyStats()
    else
        isBurstOn = false
        removeStats()
    end
end

local function updateHumanoid(char)
    Character = char
    Humanoid = char:WaitForChild("Humanoid")
    if isEnabled then applyStats() end
    if isBurstOn then applyBurst() end
end

plr.CharacterAdded:Connect(updateHumanoid)
updateHumanoid(Character)

task.spawn(function()
    while true do
        task.wait(0.1)
        if not isEnabled then
            if isBurstOn then
                isBurstOn = false
                removeBurst()
            end
            continue
        end

        isBurstOn = true
        applyBurst()
        task.wait(BurstOnTime)

        if not isEnabled then
            isBurstOn = false
            removeBurst()
            continue
        end

        isBurstOn = false
        removeBurst()
        task.wait(BurstOffTime)
    end
end)

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.P then
        setEnabled(not isEnabled)
    end
end)

