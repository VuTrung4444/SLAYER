AutoFarm:AddToggle({
    Name = "Auto Hover Mob",
    Default = false,
    Callback = function(state)
        getgenv().AutoHoverMob = state
        getgenv().HoverMobHeight = getgenv().HoverMobHeight or -6.5

        if state then
            task.spawn(function()
                local player = game:GetService("Players").LocalPlayer

                local function GetNearestMob()
                    local char = player.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if not hrp then return nil, nil end

                    local ok, regions = pcall(function()
                        return workspace.Humanoids.Regions:GetChildren()
                    end)
                    if not ok or not regions then return nil, nil end

                    local nearest, nearestRoot = nil, nil
                    local nearestDist = math.huge

                    for _, region in ipairs(regions) do
                        local activeNpcs = region:FindFirstChild("ActiveNpcs")
                        if not activeNpcs then continue end

                        for _, folder in ipairs(activeNpcs:GetChildren()) do
                            for _, npcModel in ipairs(folder:GetChildren()) do
                                if not npcModel:IsA("Model") then continue end

                                local h = npcModel:FindFirstChildWhichIsA("Humanoid", true)
                                local rootPart = npcModel:FindFirstChild("HumanoidRootPart")

                                if h and h.Health > 0 and rootPart then
                                    local dist = (hrp.Position - rootPart.Position).Magnitude
                                    if dist <= 100 and dist < nearestDist then
                                        nearestDist = dist
                                        nearest = npcModel
                                        nearestRoot = rootPart
                                    end
                                end
                            end
                        end
                    end

                    return nearest, nearestRoot
                end

                while getgenv().AutoHoverMob do
                    task.wait(0.01)

                    local char = player.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if not hrp then task.wait(0.5) continue end

                    local target, rootPart = GetNearestMob()
                    if not target or not rootPart then
                        task.wait(0.5)
                        continue
                    end

                    local humanoid = target:FindFirstChildWhichIsA("Humanoid", true)
                    if not humanoid or humanoid.Health <= 0 then
                        task.wait(0.1)
                        continue
                    end

                    local targetPos = rootPart.Position + Vector3.new(0, getgenv().HoverMobHeight, 0)
                    hrp.CFrame = CFrame.new(targetPos, rootPart.Position)
                    hrp.Velocity = Vector3.zero
                    hrp.AssemblyLinearVelocity = Vector3.zero
                end
            end)
        end
    end
})

