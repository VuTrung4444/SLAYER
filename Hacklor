getgenv().AutoChest = false
Ect:AddToggle({
    Name = "Auto Chest",
    Default = false,
    Callback = function(state)
        getgenv().AutoChest = state
        getgenv().ChestReached = false

        if state then
            -- [MỚI] chặn chạy chồng khi bật/tắt nhanh
            getgenv().ChestRunId = (getgenv().ChestRunId or 0) + 1
            local runId = getgenv().ChestRunId

            task.spawn(function()
                local player = game:GetService("Players").LocalPlayer

                local function Running()
                    return getgenv().AutoChest and runId == getgenv().ChestRunId
                end

                -- [MỚI] ignoreChest: đi nhặt rương thì không bị ChestBlocked tự chặn; tắt toggle thì hủy tween
                local moveOpts = {
                    ignoreChest = true,
                    abort = function() return not Running() end,
                }

                local function GetHRP()
                    local char = player.Character
                    return char and char:FindFirstChild("HumanoidRootPart")
                end

                local function GetChestPrompt(chest)
                    local rootPart = chest:FindFirstChild("RootPart")
                    if not rootPart then return nil, nil end

                    local prompt = rootPart:FindFirstChild("ChestPrompt")
                    if prompt then return prompt, rootPart end

                    local anchor = rootPart:FindFirstChild("ChestPromptAnchor")
                    if anchor then
                        prompt = anchor:FindFirstChild("ChestPrompt")
                        if prompt then return prompt, rootPart end
                    end

                    prompt = chest:FindFirstChild("ChestPrompt", true)
                    if prompt then return prompt, rootPart end

                    return nil, nil
                end

                local function GetNearestChest()
                    local hrp = GetHRP()
                    if not hrp then return nil end

                    local chestsFolder = workspace:FindFirstChild("Chests")
                    if not chestsFolder then return nil end

                    local nearest, nearestDist = nil, math.huge

                    for _, chest in ipairs(chestsFolder:GetChildren()) do
                        if getgenv().OpenedChests[chest] then continue end
                        if not IsChestName(chest.Name) then continue end

                        local prompt, rootPart = GetChestPrompt(chest)
                        if not prompt or not rootPart then continue end

                        local dist = (hrp.Position - rootPart.Position).Magnitude
                        if dist <= 500 and dist < nearestDist then
                            nearestDist = dist
                            nearest = chest
                        end
                    end

                    return nearest
                end

                local function CollectAllDrops()
                    local lootFolder = workspace:FindFirstChild("LootDrops")
                    if not lootFolder then return end

                    while Running() do
                        local hrp = GetHRP()
                        if not hrp then break end

                        local validDrops = {}
                        for _, drop in ipairs(lootFolder:GetChildren()) do
                            local prompt = drop:FindFirstChild("LootDropPrompt", true)
                            if not prompt then continue end

                            local dropPart
                            if drop:IsA("BasePart") then
                                dropPart = drop
                            else
                                dropPart = drop:FindFirstChildWhichIsA("BasePart", true)
                            end
                            if not dropPart then continue end

                            local dist = (hrp.Position - dropPart.Position).Magnitude
                            if dist <= 500 then
                                table.insert(validDrops, { drop = drop, prompt = prompt, part = dropPart })
                            end
                        end

                        if #validDrops == 0 then break end

                        local anyRemaining = false
                        for _, data in ipairs(validDrops) do
                            if not Running() then break end
                            if not data.drop.Parent then continue end

                            hrp = GetHRP()
                            if not hrp then break end

                            -- [SỬA] tween tới loot (có SetEquippedForTravel trong SafeMove); loot ở gần thì khỏi di chuyển
                            if (hrp.Position - data.part.Position).Magnitude > 6 then
                                if not SafeMove(data.part.Position + Vector3.new(3, 3, 0), moveOpts) then
                                    anyRemaining = true
                                    task.wait(0.3)
                                    continue
                                end
                            end
                            task.wait(0.2)

                            if data.drop.Parent then
                                fireproximityprompt(data.prompt)
                            end
                            task.wait(0.2)

                            if data.drop.Parent then
                                anyRemaining = true
                            end
                        end

                        if not anyRemaining then break end
                    end
                end

                local lastFiredChest = nil

                while Running() do
                    task.wait(0.5)

                    local hrp = GetHRP()
                    if not hrp then continue end

                    local lootFolder = workspace:FindFirstChild("LootDrops")
                    local hasDrops = false
                    if lootFolder then
                        for _, drop in ipairs(lootFolder:GetChildren()) do
                            local prompt = drop:FindFirstChild("LootDropPrompt", true)
                            if not prompt then continue end

                            local dropPart
                            if drop:IsA("BasePart") then
                                dropPart = drop
                            else
                                dropPart = drop:FindFirstChildWhichIsA("BasePart", true)
                            end
                            if not dropPart then continue end

                            local dist = (hrp.Position - dropPart.Position).Magnitude
                            if dist <= 500 then
                                hasDrops = true
                                break
                            end
                        end
                    end

                    if hasDrops then
                        -- Có loot rơi ra sau khi fire rương => rương vừa fire đã mở, không quay lại nữa
                        if lastFiredChest then
                            getgenv().OpenedChests[lastFiredChest] = true
                            lastFiredChest = nil
                            getgenv().ChestReached = false
                        end
                        CollectAllDrops()
                        continue
                    end

                    -- Soul: di chuyển tới nếu > 5 đơn vị rồi fireproximity
                    local soul, soulPrompt, soulRoot = FindNearestSoul(500)
                    if soul then
                        if (hrp.Position - soulRoot.Position).Magnitude > 5 then
                            getgenv().ChestReached = false
                            -- [SỬA] SafeMove đã gồm SetEquippedForTravel; thất bại thì thử lại ở vòng sau
                            if not SafeMove(soulRoot.Position + Vector3.new(3, 0, 0), moveOpts) then
                                continue
                            end
                            task.wait(0.3)
                        end
                        if soul.Parent then
                            fireproximityprompt(soulPrompt)
                        end
                        task.wait(0.5)
                        continue
                    end

                    local chest = GetNearestChest()
                    if not chest then
                        getgenv().ChestReached = false
                        task.wait(1)
                        continue
                    end

                    local prompt, rootPart = GetChestPrompt(chest)
                    if not prompt or not rootPart then continue end

                    -- [SỬA] tween tới rương; nếu bị đẩy lệch xa hơn 12 studs thì tween lại dù đã "Reached"
                    local distToChest = (hrp.Position - rootPart.Position).Magnitude
                    if not getgenv().ChestReached or distToChest > 12 then
                        if not SafeMove(rootPart.Position + Vector3.new(3, 0, 0), moveOpts) then
                            getgenv().ChestReached = false
                            continue
                        end
                        task.wait(0.3)
                        if not chest.Parent then continue end
                    end

                    fireproximityprompt(prompt)
                    lastFiredChest = chest
                    task.wait(0.5)

                    if chest.Parent then
                        getgenv().ChestReached = true
                    else
                        getgenv().ChestReached = false
                    end
                end
            end)
        end
    end
})



