local function IsTargetClan(clanValue)
    if getgenv().UseSupClans then
        for _, name in ipairs(TargetClansSup) do
            if clanValue == name then return true end
        end
    end
    if getgenv().UseMythClans then
        for _, name in ipairs(TargetClansMyth) do
            if clanValue == name then return true end
        end
    end
    return false
end

local function GetClanSlot()
    local username = player.Name
    local ok, result = pcall(function()
        return ReplicatedStorage
            :WaitForChild("Player_Service")
            :WaitForChild("Data")
            :WaitForChild(username)
            :WaitForChild("slots")
            :WaitForChild("Slot1")
            :WaitForChild("Clan")
    end)
    if ok then return result end
    return nil
end

local function SpinClan()
    local spinEvent = ReplicatedStorage
        :WaitForChild("Communication")
        :WaitForChild("ServerAndClient")
        :WaitForChild("Signals")
        :WaitForChild("SignalFunction")
        :WaitForChild("Function")
    spinEvent:InvokeServer("ClanSpin")

    task.wait(0.01)

    local completeEvent = ReplicatedStorage
        :WaitForChild("Communication")
        :WaitForChild("ServerAndClient")
        :WaitForChild("Signals")
        :WaitForChild("SignalEvent")
        :WaitForChild("Event")
    completeEvent:FireServer("ClanSpinComplete")
end

