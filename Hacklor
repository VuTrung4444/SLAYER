-- Tên Chest / Soul lấy từ ReplicatedStorage.Assets
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local AssetNameCache = {}

local function GetAssetNames(folderName, onlyChestModels)
    local cached = AssetNameCache[folderName]
    if cached then return cached end

    local names = {}
    local count = 0
    local assets = ReplicatedStorage:FindFirstChild("Assets")
    local folder = assets and assets:FindFirstChild(folderName)
    if folder then
        for _, child in ipairs(folder:GetChildren()) do
            if (not onlyChestModels) or (child:IsA("Model") and child.Name:find("Chest", 1, true)) then
                names[child.Name] = true
                count += 1
            end
        end
    end
    if count > 0 then AssetNameCache[folderName] = names end
    return names
end

-- Tên chứa "Chest" (như cũ) HOẶC trùng tên Model có chứa "Chest" trong Assets.Chests
local function IsChestName(name)
    if name:find("Chest", 1, true) then return true end
    return GetAssetNames("Chests", true)[name] == true
end

-- Soul: workspace.Debree[<tên trong Assets.Souls>].Root.SoulPrompt
local function FindNearestSoul(maxDist)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local debree = workspace:FindFirstChild("Debree")
    if not debree then return nil end

    local soulNames = GetAssetNames("Souls", false)
    local nearest, nearestPrompt, nearestRoot = nil, nil, nil
    local nearestDist = math.huge

    for _, obj in ipairs(debree:GetChildren()) do
        if not soulNames[obj.Name] then continue end
        local root = obj:FindFirstChild("Root")
        local prompt = root and root:FindFirstChild("SoulPrompt")
        if prompt then
            local dist = (hrp.Position - root.Position).Magnitude
            if dist <= maxDist and dist < nearestDist then
                nearestDist = dist
                nearest = obj
                nearestPrompt = prompt
                nearestRoot = root
            end
        end
    end

    return nearest, nearestPrompt, nearestRoot
end

