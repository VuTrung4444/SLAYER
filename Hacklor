AutoFarm:AddToggle({
    Name = "Auto Farm",
    Default = false,
    Callback = function(state)
        getgenv().AutoHoverMob = state
        getgenv().MobNameFilter = getgenv().MobNameFilter or ""

        if state then
            -- [MỚI] chặn chạy chồng khi bật/tắt nhanh
            getgenv().FarmRunId = (getgenv().FarmRunId or 0) + 1
            local runId = getgenv().FarmRunId

            task.spawn(function()
                local lockedTarget = nil
                local lockedRoot = nil
                local bossSpawnMoved = false
                local bossWaitStart = nil
                local BOSS_WAIT_TIME = 4
                -- [MỚI] Thời điểm gần nhất đang bám/đánh mob. Còn trong thời gian ân hạn thì KHÔNG về BossInfo
                local lastEngagedAt = 0
                local function BossReturnGrace() return getgenv().BossReturnGrace or 5 end

                local function Running()
                    return getgenv().AutoHoverMob and runId == getgenv().FarmRunId
                end

                local AllBossList = {
                    "Akazo", "Douma", "Tengai", "Obari", "Yahari",
                    "Sumari", "Giyen", "Rengu", "Fujiko", "Shinora",
                    "Saneri", "Reaper"
                }
                local allBossIndex = 1

                local function IsAllBossMode()
                    return getgenv().MobNameFilter:lower():match("^%s*(.-)%s*$") == "allboss"
                end

                local function GetCurrentBossFilter()
                    if IsAllBossMode() then
                        return AllBossList[allBossIndex]:lower()
                    end
                    return getgenv().MobNameFilter:lower():match("^%s*(.-)%s*$")
                end

                local function AdvanceAllBoss()
                    allBossIndex = allBossIndex % #AllBossList + 1
                    bossSpawnMoved = false
                    bossWaitStart = nil
                end

                local function GetNearestMob()
                    local char = player.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if not hrp then return nil, nil end

                    local ok, regions = pcall(function()
                        return workspace.Humanoids.Regions:GetChildren()
                    end)
                    if not ok or not regions then return nil, nil end

                    local nearest, nearestRoot = nil, nil
                    local nearestDist = math.huge
                    local filter = GetCurrentBossFilter()
                    local range = getgenv().MobSearchRange

                    for _, region in ipairs(regions) do
                        local activeNpcs = region:FindFirstChild("ActiveNpcs")
                        if not activeNpcs then continue end

                        for _, folder in ipairs(activeNpcs:GetChildren()) do
                            for _, npcModel in ipairs(folder:GetChildren()) do
                                if not npcModel:IsA("Model") then continue end

                                if filter ~= "" then
                                    if npcModel.Name:lower() ~= filter then continue end
                                end

                                local h = npcModel:FindFirstChildWhichIsA("Humanoid", true)
                                local rootPart = npcModel:FindFirstChild("HumanoidRootPart")

                                if h and h.Health > 0 and rootPart then
                                    local dist = (hrp.Position - rootPart.Position).Magnitude
                                    local inRange = (range == nil) or (dist <= range)

                                    if inRange and dist < nearestDist then
                                        nearestDist = dist
                                        nearest = npcModel
                                        nearestRoot = rootPart
                                    end
                                end
                            end
                        end
                    end

                    return nearest, nearestRoot
                end

                local function GetNPCPos()
                    local npcKey, npcData = ResolveNPCName(getgenv().AutoMissionName)
                    if not npcData then return nil, nil, nil end

                    if npcData.coordinates then
                        return npcKey, npcData, npcData.coordinates
                    end

                    local npcModel = nil
                    local ok, regions = pcall(function()
                        return workspace.Debree.Regions:GetChildren()
                    end)
                    if ok and regions then
                        for _, region in ipairs(regions) do
                            local stationaryNpcs = region:FindFirstChild("StationaryNpcs")
                            if stationaryNpcs then
                                local npcName = npcData.displayName or getgenv().AutoMissionName
                                for _, npc in ipairs(stationaryNpcs:GetChildren()) do
                                    if npc.Name:lower() == npcName:lower() then
                                        npcModel = npc
                                        break
                                    end
                                end
                            end
                            if npcModel then break end
                        end
                    end

                    if npcModel then
                        local okPivot, pivot = pcall(function() return npcModel:GetPivot() end)
                        if okPivot and pivot then
                            return npcKey, npcData, pivot.Position + Vector3.new(5, 2, 0)
                        end
                    end

                    return npcKey, npcData, nil
                end

                local function TryMoveToBossSpawn()
                    if bossSpawnMoved then return end
                    -- [MỚI] Vừa bám mob xong (mob chỉ tạm thời mất khỏi danh sách): chưa về BossInfo, chờ tìm lại mob
                    if tick() - lastEngagedAt < BossReturnGrace() then return end

                    local char = player.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if not hrp then return end

                    local filter = GetCurrentBossFilter()
                    if filter == "" then return end

                    local ok, regions = pcall(function()
                        return workspace.Humanoids.Regions:GetChildren()
                    end)
                    if not ok or not regions then return end

                    for _, region in ipairs(regions) do
                        local activeNpcs = region:FindFirstChild("ActiveNpcs")
                        if not activeNpcs then continue end

                        for _, folder in ipairs(activeNpcs:GetChildren()) do
                            if folder.Name:lower() ~= filter then continue end

                            local bossInfo = folder:FindFirstChild("BossInfo")
                            if not bossInfo then continue end

                            local center = bossInfo:GetAttribute("Center")
                            if center and typeof(center) == "Vector3" then
                                -- Đã ở trong 50 đơn vị quanh BossInfo: không di chuyển lại, coi như đã tới
                                if (hrp.Position - center).Magnitude <= 50 then
                                    bossSpawnMoved = true
                                    bossWaitStart = tick()
                                    return
                                end

                                -- [SỬA] tween tới điểm boss, chỉ đặt cờ khi tới nơi thành công
                                if getgenv().FarmDebug then
                                    warn("[AutoFarm] Không thấy mob '" .. filter .. "', về BossInfo")
                                end
                                if SafeMove(center, { farm = true }) then
                                    bossSpawnMoved = true
                                    bossWaitStart = tick()
                                end
                                return
                            end
                        end
                    end

                    if IsAllBossMode() then
                        AdvanceAllBoss()
                    end
                end

                local function GetNearestMobInRange(range)
                    local char = player.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if not hrp then return nil end

                    local ok, regions = pcall(function()
                        return workspace.Humanoids.Regions:GetChildren()
                    end)
                    if not ok or not regions then return nil end

                    local nearest = nil
                    local nearestDist = math.huge

                    for _, region in ipairs(regions) do
                        local activeNpcs = region:FindFirstChild("ActiveNpcs")
                        if not activeNpcs then continue end

                        for _, folder in ipairs(activeNpcs:GetChildren()) do
                            for _, npcModel in ipairs(folder:GetChildren()) do
                                if not npcModel:IsA("Model") then continue end

                                local h = npcModel:FindFirstChildWhichIsA("Humanoid", true)
                                local rootPart = npcModel:FindFirstChild("HumanoidRootPart")

                                if h and h.Health > 0 and rootPart then
                                    local dist = (hrp.Position - rootPart.Position).Magnitude
                                    if dist <= range and dist < nearestDist then
                                        nearestDist = dist
                                        nearest = npcModel
                                    end
                                end
                            end
                        end
                    end

                    return nearest
                end

                local function EquipIfMobNearby(range)
                    local ok, equipped = pcall(function()
                        return player.Items_Config.Equipped
                    end)
                    if not ok or not equipped then return end
                    if equipped.Value == 1 or equipped.Value == 2 then return end

                    if GetNearestMobInRange(range) then
                        equipped.Value = 1
                    end
                end

                -- [MỚI] Vị trí đứng cạnh mob: lệch trục X, Y = Y của mob + 3 (rồi rơi xuống đất bằng vật lý)
                local function MobStandPos(mobRoot)
                    local p = mobRoot.Position
                    return Vector3.new(p.X + getgenv().FollowSideX, p.Y + 3, p.Z)
                end

                -- [SỬA] Tiếp cận mob: ngoài FollowRange (250) thì SetEquippedForTravel + tween xa (TravelSpeed);
                -- trong FollowRange thì bám bằng tween X/Z (FollowSpeed), gồm cả logic mob bị văng (delay + chuỗi phím W/Q)
                local function ApproachMob(hrp, mobRoot)
                    local d = (hrp.Position - mobRoot.Position).Magnitude
                    if d > getgenv().FollowRange then
                        MoverStopIf("follow")
                        return SafeMove(MobStandPos(mobRoot), { farm = true })
                    end
                    MoverFollow(hrp, mobRoot)
                    return true
                end

                while Running() do
                    task.wait(0.01)

                    local char = player.Character
                    local hrp = char and char:FindFirstChild("HumanoidRootPart")
                    if not hrp then task.wait(0.5) continue end

                    -- Ưu tiên 1: Chest
                    if ChestBlocked() then
                        MoverStopIf("follow")
                        task.wait(0.5)
                        continue
                    end

                    -- Ưu tiên 2: Nhận quest nếu chưa có
                    if getgenv().AutoGetMission and not HasQuest() then
                        MoverStopIf("follow")
                        GetAndWaitForQuest(player)

                        while getgenv().AutoGetMission and not HasQuest() and Running() do
                            -- có rương thì thoát vòng quest, quay về kiểm tra rương ở đầu vòng chính
                            if ChestBlocked() then break end

                            -- [MỚI] chưa tới được NPC (tween bị hủy / chưa equip kịp) thì thử lại
                            if not getgenv().MissionNPCReached then
                                GetAndWaitForQuest(player)
                            end

                            hrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
                            if hrp and getgenv().MissionNPCReached then
                                local _, _, npcPos = GetNPCPos()

                                if npcPos then
                                    -- [SỬA] chỉ tween lại khi bị đẩy lệch khỏi NPC (thay cho teleport mỗi 0.1s)
                                    local d = hrp.Position - npcPos
                                    if Vector3.new(d.X, 0, d.Z).Magnitude > 6 or math.abs(d.Y) > 10 then
                                        SafeMove(npcPos, { farm = true })
                                    end
                                end
                            end
                            task.wait(0.1)
                        end
                        continue
                    end

                    if HasQuest() then
                        getgenv().MissionNPCReached = false
                    end

                    -- Ưu tiên 3: Di chuyển tới mob / hover / bossInfo

                    -- Chest check trước khi di chuyển tới mob
                    if ChestBlocked() then
                        MoverStopIf("follow")
                        task.wait(0.5)
                        continue
                    end

                    -- Chờ boss spawn
                    if bossSpawnMoved and bossWaitStart then
                        MoverStopIf("follow")
                        if tick() - bossWaitStart >= BOSS_WAIT_TIME then
                            local target, _ = GetNearestMob()
                            if not target then
                                if IsAllBossMode() then
                                    AdvanceAllBoss()
                                else
                                    bossSpawnMoved = false
                                    bossWaitStart = nil
                                end
                            else
                                bossWaitStart = nil
                            end
                        end
                        continue
                    end

                    if lockedTarget and lockedRoot then
                        local h = lockedTarget:FindFirstChildWhichIsA("Humanoid", true)
                        if h and h.Health > 0 and lockedTarget.Parent then
                            local filter = GetCurrentBossFilter()
                            if filter ~= "" and lockedTarget.Name:lower() ~= filter then
                                MoverStopIf("follow")
                                lockedTarget = nil
                                lockedRoot = nil
                                bossSpawnMoved = false
                                continue
                            end

                            -- Chest check khi đang hover
                            if ChestBlocked() then
                                MoverStopIf("follow")
                                task.wait(0.5)
                                continue
                            end

                            -- [SỬA] thay 4 dòng CFrame/Velocity cũ bằng bám tween
                            lastEngagedAt = tick()   -- [MỚI] đang bám mob: BossInfo không còn liên quan
                            ApproachMob(hrp, lockedRoot)
                            EquipIfMobNearby(20)
                            continue
                        else
                            MoverStopIf("follow")
                            -- [MỚI] Mob chết hẳn thì được về BossInfo ngay; chỉ biến mất/đổi model thì chờ trong thời gian ân hạn
                            if h and h.Health <= 0 then lastEngagedAt = 0 end
                            if IsAllBossMode() then
                                AdvanceAllBoss()
                            end
                            lockedTarget = nil
                            lockedRoot = nil
                            bossSpawnMoved = false
                        end
                    end

                    local target, rootPart = GetNearestMob()

                    if not target or not rootPart then
                        MoverStopIf("follow")
                        local filter = getgenv().MobNameFilter:lower():match("^%s*(.-)%s*$")
                        if filter ~= "" then
                            TryMoveToBossSpawn()
                        end
                        task.wait(1)
                        continue
                    end

                    lockedTarget = target
                    lockedRoot = rootPart
                    bossSpawnMoved = false
                    bossWaitStart = nil
                    lastEngagedAt = tick()

                    local humanoid = target:FindFirstChildWhichIsA("Humanoid", true)
                    if not humanoid or humanoid.Health <= 0 then
                        lockedTarget = nil
                        lockedRoot = nil
                        task.wait(0.1)
                        continue
                    end

                    -- [SỬA] xa thì tween xa (có SetEquippedForTravel), gần thì bám X/Z
                    if not ApproachMob(hrp, rootPart) then
                        lockedTarget = nil
                        lockedRoot = nil
                    end
                end

                MoverStopIf("follow")
                lockedTarget = nil
                lockedRoot = nil
                bossSpawnMoved = false
                bossWaitStart = nil
            end)
        end
    end
})

