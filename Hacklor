Ect:AddToggle({
    Name = "Auto Chest",
    Default = false,
    Callback = function(state)
        getgenv().AutoChest = state

        if state then
            task.spawn(function()
                local player = game:GetService("Players").LocalPlayer

                local function GetHRP()
                    local char = player.Character
                    return char and char:FindFirstChild("HumanoidRootPart")
                end

                local function GetNearestChest()
                    local hrp = GetHRP()
                    if not hrp then return nil end

                    local chestsFolder = workspace:FindFirstChild("Chests")
                    if not chestsFolder then return nil end

                    local nearest, nearestDist = nil, math.huge

                    for _, chest in ipairs(chestsFolder:GetChildren()) do
                        if not chest.Name:find("Chest", 1, true) then continue end

                        local rootPart = chest:FindFirstChild("RootPart")
                        if not rootPart then continue end

                        local prompt = rootPart:FindFirstChild("ChestPrompt")
                        if not prompt then continue end

                        local dist = (hrp.Position - rootPart.Position).Magnitude
                        if dist < nearestDist then
                            nearestDist = dist
                            nearest = chest
                        end
                    end

                    return nearest
                end

                local function CollectAllDrops()
                local lootFolder = workspace:FindFirstChild("LootDrops")
                if not lootFolder then return end

                    while getgenv().AutoChest do
                        local hrp = GetHRP()
                        if not hrp then break end

                        local drops = lootFolder:GetChildren()
                        if #drops == 0 then break end

                        local nearestDrop, nearestPrompt, nearestDist = nil, nil, math.huge

                        for _, drop in ipairs(drops) do
                            -- LootDrop có thể là Part hoặc Model
                            local prompt = drop:FindFirstChild("LootDropPrompt", true)
                            if not prompt then continue end


                            local dropPart
                            if drop:IsA("BasePart") then
                                dropPart = drop
                            else
                                dropPart = drop:FindFirstChildWhichIsA("BasePart", true)
                            end

                            if not dropPart then continue end

                            local dist = (hrp.Position - dropPart.Position).Magnitude
                            if dist < nearestDist then
                                nearestDist = dist
                                nearestDrop = drop
                                nearestPrompt = prompt
                            end
                        end

                        if not nearestDrop or not nearestPrompt then break end

                        local dropPart
                        if nearestDrop:IsA("BasePart") then
                            dropPart = nearestDrop
                        else
                            dropPart = nearestDrop:FindFirstChildWhichIsA("BasePart", true)
                        end

                        if not dropPart then
                            task.wait(0.3)
                            continue
                        end


                        hrp.CFrame = CFrame.new(dropPart.Position + Vector3.new(3, 0, 0))
                        task.wait(0.3)


                        if not nearestDrop.Parent then continue end


                        fireproximityprompt(nearestPrompt)
                        task.wait(0.3)
                    end
                end
                while getgenv().AutoChest do
                    task.wait(0.5)

                    local hrp = GetHRP()
                    if not hrp then continue end

                    local chest = GetNearestChest()
                    if not chest then
                        task.wait(1)
                        continue
                    end

                    local rootPart = chest:FindFirstChild("RootPart")
                    local prompt = rootPart and rootPart:FindFirstChild("ChestPrompt")
                    if not rootPart or not prompt then continue end


                    if not getgenv().ChestReached then
                        hrp.CFrame = CFrame.new(rootPart.Position + Vector3.new(3, 0, 0))
                        task.wait(0.3)
                    end


                    fireproximityprompt(prompt)
                    task.wait(0.5)


                    if chest.Parent then
                        getgenv().ChestReached = true
                    else
                        getgenv().ChestReached = false
                        CollectAllDrops()
                    end
                end
            end)
        end
    end
})

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

getgenv().ESPenabled = false
local ESPTextSize = 18

-- ===================== PLAYER ESP =====================

local function createPlayerESP(player)
    if player == LocalPlayer then return end

    task.spawn(function()
        -- Tìm model trong workspace.Humanoids khớp với tên player
        local ok, playerModel = pcall(function()
            return workspace.Humanoids:WaitForChild(player.Name, 5)
        end)
        if not ok or not playerModel then return end

        local rootPart = playerModel:FindFirstChild("HumanoidRootPart")
        if not rootPart then return end

        -- Dọn ESP cũ
        local oldESP = rootPart:FindFirstChild("ESP")
        if oldESP then oldESP:Destroy() end

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESP"
        billboard.Adornee = rootPart
        billboard.Size = UDim2.new(0, 200, 0, 50)
        billboard.StudsOffset = Vector3.new(0, 3, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = rootPart

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, 0, 1, 0)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.fromRGB(255, 0, 0)
        label.TextStrokeTransparency = 0
        label.Font = Enum.Font.SourceSansBold
        label.TextScaled = false
        label.TextSize = ESPTextSize
        label.Parent = billboard

        while getgenv().ESPenabled do
            local localChar = LocalPlayer.Character
            local localRoot = localChar and localChar:FindFirstChild("HumanoidRootPart")

            -- Lấy lại rootPart mới nhất từ workspace.Humanoids
            local currentRoot = playerModel:FindFirstChild("HumanoidRootPart")

            if not currentRoot or not localRoot then
                task.wait(1)
                continue
            end

            if billboard.Adornee ~= currentRoot then
                billboard.Adornee = currentRoot
            end

            local distance = (currentRoot.Position - localRoot.Position).Magnitude
            label.Text = player.Name .. " | " .. math.floor(distance) .. " studs"

            task.wait(0.5)
        end

        if billboard then billboard:Destroy() end
    end)
end

local function updateAllPlayersESP()
    for _, plr in pairs(Players:GetPlayers()) do
        createPlayerESP(plr)
    end
end

local function clearAllPlayerESP()
    for _, plr in pairs(Players:GetPlayers()) do
        local ok, playerModel = pcall(function()
            return workspace.Humanoids:FindFirstChild(plr.Name)
        end)
        if ok and playerModel then
            local rootPart = playerModel:FindFirstChild("HumanoidRootPart")
            if rootPart and rootPart:FindFirstChild("ESP") then
                rootPart.ESP:Destroy()
            end
        end
    end
end

Players.PlayerAdded:Connect(function(player)
    if getgenv().ESPenabled then
