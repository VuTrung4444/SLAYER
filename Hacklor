local function ResolveNPCName(input)
    local lower = input:lower():match("^%s*(.-)%s*$")
    for key, data in pairs(NPCData) do
        if key == lower then
            return key, data
        end
    end
    return nil, nil
end

local function ResolveQuest(npcKey, questInput)
    local data = NPCData[npcKey]
    if not data then return questInput end
    local lower = questInput:lower():match("^%s*(.-)%s*$")
    for shortcut, fullName in pairs(data.quests) do
        if shortcut == lower then
            return fullName
        end
    end
    return questInput
end

local function HasQuest()
    local ok, panel = pcall(function()
        return game:GetService("Players").LocalPlayer.PlayerGui
            .ComponentsHolder
            .LeftCenterFramesHolder
            .zQuestsFrame
            .Panel
    end)
    if not ok or not panel then return false end
    for _, child in ipairs(panel:GetChildren()) do
        if child.Name ~= "List" and child.Name ~= "UIPadding" then
            return true
        end
    end
    return false
end

local function GetAndWaitForQuest(player)
    if not getgenv().AutoGetMission then return end
    if getgenv().AutoMissionName == "" or getgenv().AutoMissionQuest == "" then return end
    if HasQuest() then return end

    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    if not getgenv().MissionNPCReached then
        local npcKey, npcData = ResolveNPCName(getgenv().AutoMissionName)

        if npcData and npcData.coordinates then
            -- [SỬA] tween tới NPC, chỉ đặt MissionNPCReached khi tới nơi thành công
            if not SafeMove(npcData.coordinates, { farm = true }) then return end
            getgenv().MissionNPCReached = true
        else
            local npcName = npcData and npcData.displayName or getgenv().AutoMissionName
            local npcModel = nil
            local ok, regions = pcall(function()
                return workspace.Debree.Regions:GetChildren()
            end)
            if ok and regions then
                for _, region in ipairs(regions) do
                    local stationaryNpcs = region:FindFirstChild("StationaryNpcs")
                    if stationaryNpcs then
                        for _, npc in ipairs(stationaryNpcs:GetChildren()) do
                            if npc.Name:lower() == npcName:lower() then
                                npcModel = npc
                                break
                            end
                        end
                    end
                    if npcModel then break end
                end
            end

            if not npcModel then return end

            local okPivot, pivot = pcall(function() return npcModel:GetPivot() end)
            if not okPivot or not pivot then return end

            -- [SỬA] tween tới NPC, chỉ đặt MissionNPCReached khi tới nơi thành công
            if not SafeMove(pivot.Position + Vector3.new(5, 2, 0), { farm = true }) then return end
            getgenv().MissionNPCReached = true
        end
    end

    local npcKey, _ = ResolveNPCName(getgenv().AutoMissionName)
    local resolvedQuest = ResolveQuest(npcKey, getgenv().AutoMissionQuest)
    local Event = game:GetService("ReplicatedStorage")
        .Communication.ServerAndClient.Signals.SignalEvent.Event

    while not HasQuest() and getgenv().AutoGetMission and getgenv().AutoHoverMob do
        Event:FireServer("AddQuest", resolvedQuest)
        task.wait(2)
    end
end

