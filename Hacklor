local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

-- Chỉ gọi noclip()/clip() có sẵn; không đụng vào nếu người dùng đang bật noclip bằng toggle
local function AcquireNoclip()
    if Mover.ownsNoclip then return end
    if Noclip ~= nil and Clip == false then return end   -- toggle noclip của bạn đang bật
    noclip()
    Mover.ownsNoclip = true
end

local function ReleaseNoclip()
    if Mover.ownsNoclip then
        clip()
        Mover.ownsNoclip = false
    end
end

local function MoverStop()
    if Mover.tween then Mover.tween:Cancel(); Mover.tween = nil end
    if Mover.conn  then Mover.conn:Disconnect(); Mover.conn = nil end
    if Mover.value then Mover.value:Destroy(); Mover.value = nil end
    Mover.hrp, Mover.mode, Mover.mobRoot = nil, nil, nil
    Mover.recovering = false
    Mover.groundY = nil
    Mover.contacted, Mover.farSince = false, nil
    Mover.keyDone = false                                 -- [MỚI]
    Mover.mobLastPos, Mover.mobSpeed = nil, 0
    ReleaseNoclip()
end

local function MoverStopIf(mode)
    if Mover.mode == mode then MoverStop() end
end

local function GetGroundY(char, hrp, x, z, refY)
    local now = tick()
    if now - Mover.groundT < 0.1 then return Mover.groundY end
    Mover.groundT = now

    local ignore = { char }
    for _, n in ipairs({ "Humanoids", "Chests", "LootDrops" }) do
        local f = workspace:FindFirstChild(n)
        if f then table.insert(ignore, f) end
    end
    rayParams.FilterDescendantsInstances = ignore

    local res = workspace:Raycast(Vector3.new(x, refY + 10, z), Vector3.new(0, -300, 0), rayParams)
    local hum = char:FindFirstChildOfClass("Humanoid")
    Mover.groundY = res and (res.Position.Y + (hum and hum.HipHeight or 2) + hrp.Size.Y / 2) or nil
    return Mover.groundY
end

local function OnHeartbeat()
    local hrp = Mover.hrp
    if not (hrp and hrp.Parent and Mover.value) then return end
    local fv = Mover.value.Value

    -- Chế độ di chuyển xa: ghi cả X/Y/Z từ tween, giữ nguyên hướng xoay
    if Mover.mode == "travel" then
        hrp.CFrame = CFrame.new(fv) * hrp.CFrame.Rotation
        hrp.AssemblyLinearVelocity = Vector3.zero
        return
    end

    -- Chế độ bám mob: X/Z từ tween, Y theo vật lý (trừ lúc đang nâng lên)
    if Mover.mode ~= "follow" then return end
    local mobRoot = Mover.mobRoot
    if not (mobRoot and mobRoot.Parent) then return end

    local char   = hrp.Parent
    local cur    = hrp.Position
    local mobPos = mobRoot.Position
    local x, z   = fv.X, fv.Z
    local vy     = hrp.AssemblyLinearVelocity.Y

    local groundY
    if getgenv().FollowGroundClamp then
        groundY = GetGroundY(char, hrp, x, z, mobPos.Y)
    end

    local tooFar   = math.abs(cur.Y - mobPos.Y) > getgenv().FollowMaxYGap
    local underGnd = groundY and cur.Y < groundY - 1
    if not Mover.recovering and (tooFar or underGnd) then
        Mover.recovering = true
    end

    local y
    if Mover.recovering then
        Mover.recoverY = math.max(mobPos.Y + 3, groundY or -math.huge)
        y, vy = fv.Y, 0                                        -- Y đi theo tween giống X/Z
        if math.abs(cur.Y - Mover.recoverY) < 1.5 then         -- lên đủ gần thì trả về vật lý
            Mover.recovering = false
            y = cur.Y
        end
    else
        y = cur.Y
    end

    local pos  = Vector3.new(x, y, z)
    local look = Vector3.new(mobPos.X, y, mobPos.Z)
    if (pos - look).Magnitude > 0.05 then
        hrp.CFrame = CFrame.lookAt(pos, look)                  -- nhìn mob, không chúi/ngửa
    else
        hrp.CFrame = CFrame.new(pos)
    end
    hrp.AssemblyLinearVelocity = Vector3.new(0, vy, 0)         -- triệt vận tốc ngang, giữ Y
end

local function MoverEnsure(hrp)
    if Mover.hrp == hrp and Mover.value and Mover.conn then return end
    MoverStop()
    Mover.hrp = hrp
    Mover.value = Instance.new("Vector3Value")
    Mover.value.Value = hrp.Position
    Mover.conn = RunService.Heartbeat:Connect(OnHeartbeat)
end

-- Bám cạnh mob (hover): gọi liên tục trong vòng lặp farm
local function MoverFollow(hrp, mobRoot)
    if Mover.mode == "travel" then return end   -- luồng khác đang di chuyển xa
    MoverEnsure(hrp)
    Mover.mode = "follow"
    if Mover.mobRoot ~= mobRoot then
        Mover.contacted, Mover.farSince = false, nil
        Mover.keyDone = false                                  -- [MỚI]
        Mover.mobLastPos, Mover.mobSpeed = nil, 0
    end  -- mob mới: tiếp cận bình thường, không delay
    Mover.mobRoot = mobRoot

    if getgenv().FollowNoclip then AcquireNoclip() else ReleaseNoclip() end

    local now = tick()
    if Mover.tween and now - Mover.lastFollow < FOLLOW_INTERVAL then return end   -- throttle
    Mover.lastFollow = now

    local p = mobRoot.Position
    local goalY = Mover.recovering and Mover.recoverY or hrp.Position.Y
    local goal  = Vector3.new(p.X + getgenv().FollowSideX, goalY, p.Z)

    -- [MỚI] Mob bị văng xa: đứng yên FollowCatchupDelay giây rồi mới đuổi theo.
    -- Chỉ áp dụng khi đã từng bám sát mob này (contacted) và không đang nâng Y; tiếp cận mob mới thì không delay
    local gapXZ = Vector3.new(goal.X - hrp.Position.X, 0, goal.Z - hrp.Position.Z).Magnitude

    -- [MỚI] Đo tốc độ mob (XZ) giữa hai lần lấy mẫu cách nhau >= FOLLOW_INTERVAL.
    -- Mob bay nhanh hơn FollowKnockSpeed = bị văng: delay ngay, không đợi khoảng cách vượt FollowCatchupDist
    if not Mover.mobLastPos then
        Mover.mobLastPos, Mover.mobLastT = p, now
    elseif now - Mover.mobLastT >= FOLLOW_INTERVAL then
        local d = p - Mover.mobLastPos
        Mover.mobSpeed = Vector3.new(d.X, 0, d.Z).Magnitude / (now - Mover.mobLastT)
        Mover.mobLastPos, Mover.mobLastT = p, now
    end
    local knocked = Mover.mobSpeed > getgenv().FollowKnockSpeed
    local far     = gapXZ > getgenv().FollowCatchupDist

    if not far and not knocked then
        Mover.contacted = true
        Mover.farSince = nil
        Mover.keyDone = false                      -- [MỚI] mob đã về tầm bám: lần văng sau sẽ chạy lại chuỗi phím
    elseif Mover.contacted and not Mover.recovering then
        if not Mover.farSince then
            Mover.farSince = now
            if Mover.tween then Mover.tween:Cancel(); Mover.tween = nil end
            Mover.value.Value = hrp.Position            -- ghim tại chỗ ngay lập tức, không tween về phía mob
            if getgenv().FarmDebug then
                warn(string.format("[Follow] mob bị văng: gap=%.1f, mobSpeed=%.1f -> chờ %.1fs",
                    gapXZ, Mover.mobSpeed, getgenv().FollowCatchupDelay))
            end
        end
        if now - Mover.farSince < getgenv().FollowCatchupDelay then return end

        -- [MỚI] Hết delay: chạy chuỗi W + Q một lần, rồi lần gọi sau mới đuổi theo mob như cũ
        if not Mover.keyDone then
            Mover.keyDone = true
            SendCatchupKeys()
            return
        end
    end

    -- [SỬA] Thời gian tween = khoảng cách / FollowSpeed (tốc độ cố định, không bao giờ vượt FollowSpeed).
    -- Tối thiểu bằng chu kỳ cập nhật để chuyển động liền mạch, không bước giật từng nhịp
    local t = math.max((goal - hrp.Position).Magnitude / getgenv().FollowSpeed, FOLLOW_INTERVAL)

    if Mover.tween then Mover.tween:Cancel() end
    Mover.tween = TweenService:Create(
        Mover.value,
        TweenInfo.new(t, Enum.EasingStyle.Linear),
        { Value = goal }
    )
    Mover.tween:Play()
end

local function ShouldAbort(opts)
    if opts.farm and not getgenv().AutoHoverMob then return true end
    if not opts.ignoreChest and getgenv().ChestPresentCached then return true end
    if opts.abort and opts.abort() then return true end
    return false
end

-- Di chuyển xa tới một vị trí (thay cho root.CFrame = cf). Chặn cho tới khi tới nơi hoặc bị hủy
local function TravelTween(hrp, dest, opts)
    if Mover.mode == "travel" then return false end
    MoverStop()
    MoverEnsure(hrp)
    Mover.mode = "travel"
    AcquireNoclip()

    Mover.value.Value = hrp.Position
    local dist = (dest - hrp.Position).Magnitude
    local t = math.max(dist / getgenv().TravelSpeed, 0.1)   -- tốc độ ổn định; 0.1s tối thiểu để tween không quá ngắn

    local tw = TweenService:Create(Mover.value, TweenInfo.new(t, Enum.EasingStyle.Linear), { Value = dest })
    Mover.tween = tw

    local state
    local c = tw.Completed:Connect(function(s) state = s end)
    tw:Play()

    local aborted = false
    while state == nil do
        if not hrp.Parent or ShouldAbort(opts) then
            aborted = true
            tw:Cancel()
            break
        end
        RunService.Heartbeat:Wait()
    end
    c:Disconnect()

    MoverStop()   -- trả nhân vật về vật lý bình thường, gỡ noclip do script bật
    return (not aborted) and state == Enum.PlaybackState.Completed
end

-- Cổng di chuyển duy nhất của farm/quest/chest/loot:
-- kiểm tra rương trước VÀ sau SetEquippedForTravel (có yield 1.5s), chỉ di chuyển khi Equipped thực sự bằng 4
-- opts.farm        = true  -> tự hủy khi tắt Auto Farm
-- opts.ignoreChest = true  -> dùng cho chính việc đi nhặt rương/loot (không bị ChestBlocked chặn)
-- opts.abort       = function() return bool end  -> điều kiện hủy tùy ý
local function SafeMove(dest, opts)
    opts = opts or {}
    if not opts.ignoreChest and ChestBlocked() then return false end
    SetEquippedForTravel()
    if not IsTravelEquipped() then return false end
    if not opts.ignoreChest and ChestBlocked() then return false end
    if opts.farm and not getgenv().AutoHoverMob then return false end

    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    return TravelTween(hrp, dest, opts)
end
getgenv().TweenTravelTo = SafeMove   -- để code AutoChest / AutoLoot gọi: TweenTravelTo(pos, {ignoreChest = true})
